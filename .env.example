# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.
#
# For the local stack these are the values `supabase start` prints. Run
# `supabase status` any time to see them again.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-anon-key-from-supabase-status

# The shared password in front of the whole site. Server-only: it must NOT start
# with NEXT_PUBLIC_, or it would be baked into the JavaScript every visitor gets.
# Set the same value in Vercel when you deploy. If it is missing the site stays
# locked for everyone — it fails closed, never open.
SITE_PASSWORD=choose-a-password
