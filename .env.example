# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.
#
# For the local stack these are the values `supabase start` prints. Run
# `supabase status` any time to see them again.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-anon-key-from-supabase-status
